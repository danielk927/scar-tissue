# Copy to .env (never commit .env). Every service reads the repo-root .env (SPEC 7.5).

# --- shared ---
DATABASE_URL=postgresql://scar:scar@localhost:5432/scar
ENV_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002
TRAIN_SERVICE_URL=http://localhost:8003

# --- Person 1 ---
HF_TOKEN=
REFLECTION_LM_BASE_URL=           # OpenAI-compatible endpoint of a strong model (lessons + GEPA)
REFLECTION_LM_API_KEY=
REFLECTION_LM_MODEL=
PARAPHRASE_LM_BASE_URL=           # optional; question paraphrasing for variants
PARAPHRASE_LM_API_KEY=
PARAPHRASE_LM_MODEL=

# --- Person 2 ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_REPLAY_RATE=0  # set to 1 for the demo
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.14.0
TYPESAFE_BASE_URL=                # leave empty for Jev; set only for the Tev1 fallback
PARSE_LM_BASE_URL=
PARSE_LM_API_KEY=
PARSE_LM_MODEL=
DEV_MODEL_BASE_URL=               # DEV ONLY: used when model_version == "dev"
DEV_MODEL_ID=
DEV_MODEL_API_KEY=

# --- Person 3 ---
VERI_API_KEY=                     # see docs/VERI.md for the exact variable name
VERI_DEPLOYMENT_ID=
VERI_TRAIN_GPU_TYPE=H100-80GB
VERI_TRAIN_GPU_COUNT=1
VERI_TRAIN_PROVIDER=vast
VERI_SCALE_TO_ZERO_WINDOW_SECONDS=900
BASE_MODEL_HF_ID=Qwen/Qwen3-4B-Instruct-2507
TRAINER=fake                      # fake (tests and tiny smoke only) or veri
LOOP_RUN_DIR=                     # loop step state; default <repo>/runs
MODEL_API_KEY=                    # key for the model endpoint(s) in the registry
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=
